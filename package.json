{
  "name": "dsh-plugins-update",
  "version": "0.1.1",
  "description": "A DeepSeek Harness plugin for one-click updating third-party plugins in desktop & web client.",
  "author": "fengzhiyushui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fengzhiyushui/dsh-plugins-update.git"
  },
  "homepage": "https://github.com/fengzhiyushui/dsh-plugins-update#readme",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/client.js",
    "lib/client.d.ts",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/types.d.ts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README_zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "plugin-manager",
    "updater"
  ],
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}
